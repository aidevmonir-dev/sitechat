# Copy to .env and fill in. Never commit the real .env.

# Required in production: a long random string.
SECRET_KEY=
# 1 for local development only.
DEBUG=0
ALLOWED_HOSTS=chat.example.com
CSRF_TRUSTED_ORIGINS=https://chat.example.com

# Claude API key from https://platform.claude.com/ . Without it the widget still works
# and replies by quoting the best-matching help article.
ANTHROPIC_API_KEY=
# Any current Claude model. claude-haiku-5-5 is the cheapest for a public demo.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Email for contact-request notifications. Leave EMAIL_HOST empty to print them to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SiteChat <no-reply@example.com>

# Limits (defaults shown).
MESSAGES_PER_IP_PER_DAY=60
MESSAGES_PER_DAY_TOTAL=800
RETENTION_DAYS=30
